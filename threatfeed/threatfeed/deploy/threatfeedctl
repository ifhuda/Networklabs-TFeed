#!/usr/bin/env bash
#===============================================================================
#  threatfeedctl — perintah bantu harian untuk IoC-WATCH Threat Feed Server
#  Dipasang otomatis oleh deploy/setup.sh ke /usr/local/bin/threatfeedctl
#===============================================================================
set -Eeuo pipefail

APP_USER=threatfeed
APP_DIR=/opt/threatfeed
DATA_DIR=/var/lib/threatfeed
CONF_DIR=/etc/threatfeed
ENV_FILE="$CONF_DIR/threatfeed.env"
DB="$DATA_DIR/threatfeed.db"
BACKUP_DIR=/var/backups/threatfeed

if [[ -t 1 ]]; then
  C_G=$'\033[32m'; C_Y=$'\033[33m'; C_R=$'\033[31m'; C_C=$'\033[36m'; C_B=$'\033[1m'; C_0=$'\033[0m'
else C_G=""; C_Y=""; C_R=""; C_C=""; C_B=""; C_0=""; fi

die() { printf '%sGagal:%s %s\n' "$C_R" "$C_0" "$*" >&2; exit 1; }
need_root() { [[ $EUID -eq 0 ]] || die "Perintah ini butuh root: sudo threatfeedctl $CMD"; }

# Perintah yang berbicara ke API butuh service hidup. Tanpa penjaga ini, operator
# hanya melihat "curl: (7) Couldn't connect" tanpa tahu langkah berikutnya.
need_service() {
  curl -sf "$BASE/healthz" >/dev/null 2>&1 || die "Service tidak merespons di $BASE
    Cek dengan:  threatfeedctl status
    Log:         journalctl -u threatfeed -n 30 --no-pager"
}

[[ -f $ENV_FILE ]] || die "$ENV_FILE tidak ditemukan. Sudah dipasang lewat setup.sh?"

getenv() { awk -F= -v k="$1" '$1==k{sub("^"k"=","");print;exit}' "$ENV_FILE"; }

# Jalankan perintah sebagai service account. Penting untuk akses SQLite: kalau root
# membuka database, berkas -wal/-shm akan jadi milik root dan service kehilangan
# akses tulis. runuser selalu tersedia (util-linux); sudo belum tentu.
as_app() {
  if [[ $(id -un) == "$APP_USER" ]]; then "$@"
  elif command -v runuser >/dev/null 2>&1; then runuser -u "$APP_USER" -- "$@"
  elif command -v sudo    >/dev/null 2>&1; then sudo -u "$APP_USER" "$@"
  else die "Butuh 'runuser' atau 'sudo' untuk berjalan sebagai $APP_USER."
  fi
}

PORT=$(awk '/--port/{for(i=1;i<=NF;i++) if($i=="--port") print $(i+1)}' \
       /etc/systemd/system/threatfeed.service 2>/dev/null || true)
PORT=${PORT:-8080}
BASE="http://127.0.0.1:$PORT"

ING=$(getenv TF_INGEST_TOKENS); ING=${ING%%,*}
FGT=$(getenv TF_FEED_TOKENS);   FGT=${FGT%%,*}

usage() {
cat <<EOF
${C_B}threatfeedctl${C_0} — kelola IoC-WATCH Threat Feed Server

  ${C_C}status${C_0}              Ringkasan service, database, dan feed
  ${C_C}logs${C_0} [n|-f]         Log service (default 50 baris; -f untuk mengikuti)
  ${C_C}restart${C_0}             Restart service
  ${C_C}creds${C_0}               Tampilkan URL, password dashboard, dan token
  ${C_C}config${C_0}              Buka $ENV_FILE di editor lalu restart

  ${C_C}test${C_0} [IP]           Push satu IoC uji (default 192.0.2.99)
  ${C_C}feed${C_0} [n]            Intip isi feed yang dilihat FortiGate
  ${C_C}stats${C_0}               Statistik indikator per severity/TLP/sumber
  ${C_C}audit${C_0} [n]           Jejak audit terakhir
  ${C_C}search${C_0} <teks>       Cari indikator di database

  ${C_C}prune${C_0}               Jalankan pruning TTL sekarang
  ${C_C}expire${C_0} <IP>         Cabut satu IP dari feed
  ${C_C}backup${C_0}              Backup database (aman saat service hidup)
  ${C_C}restore${C_0} <file>      Pulihkan database dari backup

  ${C_C}rotate${C_0} ingest|feed|admin    Ganti kredensial tanpa downtime
  ${C_C}doctor${C_0}              Periksa 10 titik kegagalan tersering
EOF
}

CMD=${1:-help}; shift || true

case "$CMD" in

status)
  printf '%sService%s\n' "$C_B" "$C_0"
  if systemctl is-active --quiet threatfeed; then
    UP=$(systemctl show threatfeed -p ActiveEnterTimestamp --value)
    printf '  %s●%s aktif sejak %s\n' "$C_G" "$C_0" "$UP"
  else
    printf '  %s●%s tidak aktif\n' "$C_R" "$C_0"
  fi
  printf '  port internal %s · TTL %s hari\n' "$PORT" "$(getenv TF_TTL_DAYS)"

  printf '\n%sDatabase%s\n' "$C_B" "$C_0"
  if [[ -f $DB ]]; then
    printf '  %s · %s\n' "$DB" "$(du -h "$DB" | cut -f1)"
    as_app sqlite3 "$DB" \
      "SELECT '  ' || COUNT(*) || ' indikator (' ||
       SUM(status='active') || ' aktif, ' ||
       SUM(status='expired') || ' kedaluwarsa, ' ||
       SUM(status='revoked') || ' dicabut)' FROM indicators;"
  else
    printf '  belum ada\n'
  fi

  printf '\n%sFeed%s\n' "$C_B" "$C_0"
  # grep -c mencetak "0" DAN keluar dengan status 1; pakai `|| true`, bukan
  # `|| echo 0`, supaya tidak menghasilkan dua baris angka.
  N=$(curl -sf "$BASE/api/v1/feed/fortigate/clean" -H "Authorization: Bearer $FGT" | grep -c . || true)
  if curl -sf "$BASE/healthz" >/dev/null 2>&1; then
    printf '  %s entri sedang disajikan ke FortiGate\n' "${N:-0}"
  else
    printf '  %stidak dapat dibaca — service sedang mati%s\n' "$C_Y" "$C_0"
  fi

  printf '\n%sAktivitas terakhir%s\n' "$C_B" "$C_0"
  as_app sqlite3 -separator '  ' "$DB" \
    "SELECT '  ' || ts, action, client_ip, 'ok=' || entries_ok FROM audit_log
     WHERE action IN ('ingest','feed_pull') ORDER BY id DESC LIMIT 5;" 2>/dev/null || true
  ;;

logs)
  A=${1:-50}
  if [[ $A == -f ]]; then journalctl -u threatfeed -f
  else journalctl -u threatfeed -n "$A" --no-pager; fi
  ;;

restart)
  need_root
  systemctl restart threatfeed
  sleep 1.5
  systemctl is-active --quiet threatfeed \
    && printf '%s✓%s service aktif kembali\n' "$C_G" "$C_0" \
    || { journalctl -u threatfeed -n 20 --no-pager; die "service gagal start"; }
  ;;

creds)
  need_root
  DOM=$(awk '/server_name/{print $2;exit}' /etc/nginx/sites-available/threatfeed.conf 2>/dev/null || true)
  URL=${DOM:+https://${DOM%;}}
  printf '\n%sDashboard%s   %s/\n' "$C_B" "$C_0" "${URL:-$BASE}"
  printf '%sPassword%s    %s%s%s\n\n' "$C_B" "$C_0" "$C_Y" "$(getenv TF_ADMIN_PASSWORD)" "$C_0"
  printf '%sToken FortiSOAR (ingest)%s\n  %s\n\n' "$C_B" "$C_0" "$(getenv TF_INGEST_TOKENS)"
  printf '%sToken FortiGate (feed)%s\n  %s\n\n' "$C_B" "$C_0" "$(getenv TF_FEED_TOKENS)"
  [[ -f $CONF_DIR/INSTALL-SUMMARY.txt ]] && \
    printf 'Konfigurasi FortiGate siap tempel: %s\n\n' "$CONF_DIR/INSTALL-SUMMARY.txt"
  ;;

config)
  need_root
  "${EDITOR:-nano}" "$ENV_FILE"
  read -r -p "Restart service sekarang? [Y/n] " a
  [[ ${a,,} == n ]] || { systemctl restart threatfeed; printf '%s✓%s direstart\n' "$C_G" "$C_0"; }
  ;;

test)
  need_service
  IP=${1:-192.0.2.99}
  curl -sS -X POST "$BASE/api/v1/ingest" \
    -H "Authorization: Bearer $ING" -H 'Content-Type: application/json' \
    -d "{\"commands\":[{\"name\":\"threatfeedctl\",\"command\":\"add\",\"entries\":[
        {\"ip\":\"$IP\",\"type\":\"Manual Test\",\"severity\":\"Low\",\"confidence\":10,
         \"tlp\":\"TLP:WHITE\",\"source\":\"threatfeedctl\",\"comment\":\"Uji manual\"}]}]}" \
    | python3 -m json.tool
  ;;

feed)
  need_service
  N=${1:-25}
  printf '%sPreview feed (%s baris pertama)%s\n' "$C_B" "$N" "$C_0"
  curl -sS "$BASE/api/v1/feed/fortigate/annotated" -H "Authorization: Bearer $FGT" \
    | awk -v n="$N" 'NR<=n'
  # grep -c keluar dengan status 1 saat nol; `|| true`, bukan `|| echo 0`.
  TOT=$(curl -sf "$BASE/api/v1/feed/fortigate/clean" -H "Authorization: Bearer $FGT" | grep -c . || true)
  printf '\n%s entri total disajikan ke FortiGate.\n' "${TOT:-0}"
  ;;

stats)
  as_app sqlite3 -box "$DB" \
    "SELECT severity AS Severity, COUNT(*) AS Jumlah FROM indicators
     WHERE status='active' GROUP BY severity ORDER BY Jumlah DESC;"
  as_app sqlite3 -box "$DB" \
    "SELECT tlp AS TLP, COUNT(*) AS Jumlah FROM indicators
     WHERE status='active' GROUP BY tlp ORDER BY Jumlah DESC;"
  as_app sqlite3 -box "$DB" \
    "SELECT source AS Sumber, COUNT(*) AS Jumlah, MAX(updated_at) AS Terakhir
     FROM indicators GROUP BY source ORDER BY Jumlah DESC LIMIT 10;"
  ;;

audit)
  N=${1:-20}
  as_app sqlite3 -box "$DB" \
    "SELECT ts AS Waktu, action AS Aksi, client_ip AS Klien,
            entries_ok AS OK, entries_fail AS Gagal, status_code AS Kode
     FROM audit_log ORDER BY id DESC LIMIT $N;"
  ;;

search)
  [[ $# -gt 0 ]] || die "Pakai: threatfeedctl search <teks>"
  Q=$1
  WHERE="WHERE ip_address LIKE '%$Q%' OR type LIKE '%$Q%' OR source LIKE '%$Q%'
            OR comment LIKE '%$Q%' OR severity LIKE '%$Q%' OR tlp LIKE '%$Q%'
            OR feed_name LIKE '%$Q%'"
  HITS=$(as_app sqlite3 "$DB" "SELECT COUNT(*) FROM indicators $WHERE;")
  if [[ ${HITS:-0} -eq 0 ]]; then
    printf 'Tidak ada indikator yang cocok dengan "%s".\n' "$Q"
    exit 0
  fi
  as_app sqlite3 -box "$DB" \
    "SELECT ip_address AS IP, type AS Tipe, severity AS Severity, confidence AS Conf,
            tlp AS TLP, status AS Status, updated_at AS Diperbarui, comment AS Komentar
     FROM indicators $WHERE
     ORDER BY updated_at DESC LIMIT 50;"
  printf '\n%s indikator cocok%s\n' "$HITS" "$([[ $HITS -gt 50 ]] && echo ' (50 teratas ditampilkan)')"
  ;;

prune)
  need_root
  # Modul dipanggil langsung dengan environment yang sama seperti service,
  # supaya TTL dan path database persis sama dengan yang dipakai uvicorn.
  # mapfile, bukan `env $(grep …)`: hasil command substitution yang tidak dikutip
  # akan dipecah shell pada spasi, sehingga baris seperti
  #   TF_APP_NAME="IoC-WATCH Threat Feed Server"
  # terbelah dan env mencoba mengeksekusi kata "Threat".
  local_env=()
  mapfile -t local_env < <(sed -n 's/^\(TF_[A-Z_]*\)="\?\([^"]*\)"\?$/\1=\2/p' "$ENV_FILE")
  ( cd "$APP_DIR" && as_app env "${local_env[@]}" \
      "$APP_DIR/.venv/bin/python" - <<'PY'
from app import crud, database
database.init_db()
r = crud.prune()
print("kedaluwarsa=%(expired)s dihapus=%(deleted)s audit_dipangkas=%(audit_purged)s" % r)
PY
  ) || die "Pruning gagal. Cek: journalctl -u threatfeed -n 30"
  ;;

expire)
  need_root
  need_service
  [[ $# -gt 0 ]] || die "Pakai: threatfeedctl expire <IP>"
  curl -sS -X POST "$BASE/api/v1/ingest" \
    -H "Authorization: Bearer $ING" -H 'Content-Type: application/json' \
    -d "{\"commands\":[{\"name\":\"manual\",\"command\":\"delete\",\"entries\":[\"$1\"]}]}" \
    | python3 -m json.tool
  ;;

backup)
  need_root
  # Dimiliki service account: perintah .backup di bawah dijalankan sebagai $APP_USER.
  install -d -o "$APP_USER" -g "$APP_USER" -m 750 "$BACKUP_DIR"
  F="$BACKUP_DIR/threatfeed-$(date +%Y%m%d-%H%M%S).db"
  # .backup aman saat service hidup; `cp` biasa bisa memotong WAL.
  as_app sqlite3 "$DB" ".backup '$F'"
  chmod 600 "$F"
  printf '%s✓%s Backup: %s (%s)\n' "$C_G" "$C_0" "$F" "$(du -h "$F" | cut -f1)"
  ls -1t "$BACKUP_DIR" | awk 'NR>14' | while read -r old; do rm -f "$BACKUP_DIR/$old"; done
  ;;

restore)
  need_root
  [[ $# -gt 0 && -f $1 ]] || die "Pakai: threatfeedctl restore /var/backups/threatfeed/xxx.db"
  read -r -p "Timpa database saat ini dengan $1? [y/N] " a
  [[ ${a,,} == y ]] || exit 0
  systemctl stop threatfeed
  cp "$DB" "$DB.before-restore-$(date +%s)" 2>/dev/null || true
  rm -f "$DB" "$DB-wal" "$DB-shm"
  install -o "$APP_USER" -g "$APP_USER" -m 640 "$1" "$DB"
  systemctl start threatfeed
  printf '%s✓%s Dipulihkan dari %s\n' "$C_G" "$C_0" "$1"
  ;;

rotate)
  need_root
  W=${1:-}
  case "$W" in
    ingest|feed)
      KEY=$([[ $W == ingest ]] && echo TF_INGEST_TOKENS || echo TF_FEED_TOKENS)
      CUR=$(getenv "$KEY")
      CLIENT=$([[ $W == ingest ]] && echo FortiSOAR || echo FortiGate)

      if [[ ${2:-} == --finish ]]; then
        # Buang token lama; hanya token pertama (yang baru) yang tetap berlaku.
        sed -i "s|^$KEY=.*|$KEY=${CUR%%,*}|" "$ENV_FILE"
        systemctl restart threatfeed
        printf '%s✓%s Token lama dicabut. Hanya token baru yang berlaku sekarang.\n' "$C_G" "$C_0"
        exit 0
      fi

      NEW=$(openssl rand -hex 32)
      # Dua token aktif berdampingan supaya tidak ada downtime saat pemindahan.
      sed -i "s|^$KEY=.*|$KEY=$NEW,${CUR%%,*}|" "$ENV_FILE"
      systemctl restart threatfeed
      printf '\n%sToken %s baru:%s\n  %s\n\n' "$C_B" "$W" "$C_0" "$NEW"
      printf 'Token lama MASIH berlaku. Setelah %s dipindah ke token baru, jalankan:\n' "$CLIENT"
      printf '  %sthreatfeedctl rotate %s --finish%s\n\n' "$C_C" "$W" "$C_0"
      ;;
    admin)
      NEW=$(openssl rand -base64 24 | tr -d '/+=' | cut -c1-20)
      sed -i "s|^TF_ADMIN_PASSWORD=.*|TF_ADMIN_PASSWORD=$NEW|" "$ENV_FILE"
      systemctl restart threatfeed
      printf '\n%sPassword dashboard baru:%s %s%s%s\n\n' "$C_B" "$C_0" "$C_Y" "$NEW" "$C_0"
      ;;
    *) die "Pakai: threatfeedctl rotate ingest|feed|admin" ;;
  esac
  ;;

doctor)
  need_root
  PASS=0; FAIL=0
  chk() { # chk <label> <perintah...>
    local label=$1; shift
    if "$@" >/dev/null 2>&1; then printf '  %s✓%s %s\n' "$C_G" "$C_0" "$label"; PASS=$((PASS+1))
    else printf '  %s✗%s %s\n' "$C_R" "$C_0" "$label"; FAIL=$((FAIL+1)); fi
  }
  note() { printf '      %s%s%s\n' "$C_Y" "$1" "$C_0"; }

  printf '\n%sPemeriksaan IoC-WATCH%s\n\n' "$C_B" "$C_0"

  chk "service threatfeed aktif"        systemctl is-active --quiet threatfeed
  chk "service enabled saat boot"       systemctl is-enabled --quiet threatfeed
  chk "aplikasi merespons di $BASE"     curl -sf "$BASE/healthz"
  chk "database dapat dibaca"           as_app sqlite3 "$DB" "SELECT 1 FROM indicators LIMIT 1;"
  chk "token ingest terisi"             test -n "$ING"
  chk "token feed terisi"               test -n "$FGT"
  chk "endpoint ingest menolak token salah" \
      test "$(curl -s -o /dev/null -w '%{http_code}' -X POST "$BASE/api/v1/ingest" \
              -H 'Authorization: Bearer salah' -H 'Content-Type: application/json' -d '[]')" = 401
  chk "endpoint feed menjawab 200"      test "$(curl -s -o /dev/null -w '%{http_code}' \
              -H "Authorization: Bearer $FGT" "$BASE/api/v1/feed/fortigate")" = 200

  # --- nginx & TLS ---------------------------------------------------------
  if [[ -f /etc/nginx/sites-enabled/threatfeed.conf ]]; then
    chk "nginx aktif"                   systemctl is-active --quiet nginx
    chk "konfigurasi nginx valid"       nginx -t
    CRT=$(awk '/ssl_certificate /{print $2;exit}' /etc/nginx/sites-enabled/threatfeed.conf | tr -d ';')
    SRV=$(awk '/server_name/{print $2;exit}' /etc/nginx/sites-enabled/threatfeed.conf | tr -d ';')
    if [[ -r $CRT ]]; then
      SAN=$(openssl x509 -in "$CRT" -noout -text 2>/dev/null | grep -A1 "Alternative" | tail -1 | tr -d ' ')
      if grep -q "$SRV" <<<"$SAN"; then
        printf '  %s✓%s sertifikat mencakup %s\n' "$C_G" "$C_0" "$SRV"; PASS=$((PASS+1))
      else
        printf '  %s✗%s sertifikat TIDAK mencakup %s\n' "$C_R" "$C_0" "$SRV"; FAIL=$((FAIL+1))
        note "SAN saat ini: ${SAN:-kosong}"
        note "FortiGate akan melaporkan 'Server not reachable'."
      fi
      ISS=$(openssl x509 -in "$CRT" -noout -issuer 2>/dev/null)
      SUB=$(openssl x509 -in "$CRT" -noout -subject 2>/dev/null)
      [[ ${ISS#issuer=} == "${SUB#subject=}" ]] && \
        note "Sertifikat self-signed — FortiGate perlu 'set server-identity-check none'."
    fi
  else
    note "nginx tidak dikonfigurasi — server hanya mendengar di loopback."
    note "Pasang dengan: sudo bash deploy/setup.sh --tls self-signed --domain <IP>"
  fi

  # --- kebijakan -----------------------------------------------------------
  printf '\n%sKebijakan%s\n' "$C_B" "$C_0"
  printf '  TTL              %s hari%s\n' "$(getenv TF_TTL_DAYS)" \
    "$([[ $(getenv TF_TTL_DAYS) == 0 ]] && echo ' (tanpa kedaluwarsa)')"
  IC=$(getenv TF_INGEST_ALLOWED_CIDRS); FC=$(getenv TF_FEED_ALLOWED_CIDRS)
  printf '  allowlist ingest %s\n' "${IC:-<kosong = semua IP diizinkan>}"
  printf '  allowlist feed   %s\n' "${FC:-<kosong = semua IP diizinkan>}"
  [[ -z $IC ]] && note "Batasi TF_INGEST_ALLOWED_CIDRS ke IP FortiSOAR."
  [[ -z $FC ]] && note "Batasi TF_FEED_ALLOWED_CIDRS ke IP FortiGate."

  # --- klien terakhir ------------------------------------------------------
  printf '\n%sKlien yang terlihat server%s\n' "$C_B" "$C_0"
  as_app sqlite3 -separator '  ' "$DB" \
    "SELECT '  ' || action, client_ip, 'terakhir ' || MAX(ts) FROM audit_log
     WHERE action IN ('ingest','feed_pull') GROUP BY action, client_ip ORDER BY MAX(ts) DESC LIMIT 6;" \
    2>/dev/null || true
  note "Cocokkan IP di atas dengan allowlist — inilah IP asli setelah NAT."

  printf '\n  %s%s lulus%s · %s%s gagal%s\n\n' "$C_G" "$PASS" "$C_0" \
    "$([[ $FAIL -gt 0 ]] && printf '%s' "$C_R" || printf '%s' "$C_G")" "$FAIL" "$C_0"
  [[ $FAIL -eq 0 ]] || exit 1
  ;;

help|--help|-h) usage ;;
*) printf '%sPerintah tidak dikenal: %s%s\n\n' "$C_R" "$CMD" "$C_0"; usage; exit 1 ;;
esac
