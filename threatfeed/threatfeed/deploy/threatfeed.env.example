# /etc/threatfeed/threatfeed.env      chmod 600, chown root:threatfeed
# Semua nilai dibaca saat service start. Ubah nilai -> systemctl restart threatfeed

# --- identitas & storage ---------------------------------------------------
TF_APP_NAME="IoC-WATCH Threat Feed Server"
TF_DB_PATH=/var/lib/threatfeed/threatfeed.db

# --- kredensial (WAJIB diganti) --------------------------------------------
# Buat dengan: openssl rand -hex 32
TF_INGEST_TOKENS=GANTI_TOKEN_FORTISOAR
TF_FEED_TOKENS=GANTI_TOKEN_FORTIGATE
TF_ADMIN_PASSWORD=GANTI_PASSWORD_DASHBOARD
TF_SECRET_KEY=GANTI_DENGAN_openssl_rand_hex_32
TF_SESSION_TTL_HOURS=12
TF_COOKIE_SECURE=true

# Beberapa token dipisah koma (memudahkan rotasi tanpa downtime):
# TF_INGEST_TOKENS=token_baru,token_lama

# --- kebijakan feed --------------------------------------------------------
TF_TTL_DAYS=30
TF_HARD_DELETE_DAYS=0
TF_PRUNE_INTERVAL_SECONDS=3600
TF_FEED_MAX_ENTRIES=131072
TF_FEED_MIN_CONFIDENCE=0
# Komentar inline setelah IP (format: 103.74.20.57 # Malware | ... | C2 Server).
# Dokumentasi FortiOS hanya menjamin komentar baris-penuh; validasi dulu dengan
# `diagnose sys external-resource entry-list <nama>` sebelum dipakai produksi.
TF_FEED_INLINE_COMMENTS=false
# Isi komentar: plain | short | full
#   plain -> C2 Server detected                                    (kolom comment saja)
#   short -> Malware | C2 Server detected
#   full  -> Malware | Malicious/100 | TLP:RED | FortiSOAR | C2 Server detected
TF_FEED_COMMENT_FORMAT=plain

# --- kontrol akses jaringan (kosong = semua diizinkan) ---------------------
TF_INGEST_ALLOWED_CIDRS=10.10.10.20/32
TF_FEED_ALLOWED_CIDRS=10.10.10.0/24,203.0.113.10/32
TF_TRUST_PROXY=true

# --- retensi audit ---------------------------------------------------------
TF_AUDIT_RETENTION_DAYS=90

# --- default entri saat FortiSOAR tidak mengirim field ---------------------
TF_DEFAULT_TYPE="IP Address"
TF_DEFAULT_SEVERITY=Medium
TF_DEFAULT_TLP=TLP:AMBER
TF_DEFAULT_SOURCE=FortiSOAR
TF_DEFAULT_CONFIDENCE=50
