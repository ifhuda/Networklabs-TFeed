[Unit]
Description=Apply staged threatfeed .env and restart the service
Documentation=file:///opt/threatfeed-src/docs/SYSTEM-CONFIG.md

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/threatfeed-apply-env
StandardOutput=journal
StandardError=journal
SyslogIdentifier=threatfeed-apply-env

# Dijalankan sesaat dan hanya menyentuh dua path.
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX
RestrictRealtime=true
LockPersonality=true
TimeoutStartSec=60
