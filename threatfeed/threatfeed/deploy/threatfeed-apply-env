#!/usr/bin/env bash
#===============================================================================
#  threatfeed-apply-env — dipasang di /usr/local/sbin, dijalankan sebagai root
#  lewat satu aturan sudoers yang sempit.
#
#  Aplikasi web TIDAK punya izin tulis ke /etc/threatfeed. Ia hanya menuliskan
#  berkas kandidat ke spool, lalu memanggil skrip ini. Skrip memvalidasi ulang
#  setiap baris dari nol — aplikasi yang menghadap jaringan diperlakukan sebagai
#  pihak tak dipercaya, sehingga bug atau sesi dashboard yang dibajak tidak
#  langsung berarti kendali penuh atas konfigurasi maupun eksekusi perintah.
#
#  Dipanggil tanpa argumen. Tidak menerima input dari argv sama sekali, supaya
#  tidak ada permukaan injeksi lewat parameter.
#===============================================================================
set -Eeuo pipefail

SPOOL=/var/lib/threatfeed/pending.env
RESULT=/var/lib/threatfeed/apply-result
TARGET=/etc/threatfeed/threatfeed.env
BACKUP_DIR=/var/backups/threatfeed
APP_USER=threatfeed
UNIT=threatfeed

# Aplikasi tidak lagi memanggil skrip ini secara langsung (systemd yang
# menjalankannya), jadi status keluar tidak terlihat olehnya. Hasil ditulis ke
# berkas yang dibaca aplikasi — dan berkas kandidat selalu dibuang, supaya
# kandidat yang ditolak tidak memicu path unit berulang-ulang.
report() {
  printf '%s|%s|%s\n' "$1" "$(date -Is)" "$2" > "$RESULT" 2>/dev/null || true
  chmod 644 "$RESULT" 2>/dev/null || true
}
die() {
  printf 'threatfeed-apply-env: %s\n' "$*" >&2
  report error "$*"
  rm -f "$SPOOL"
  exit 1
}

[[ $EUID -eq 0 ]] || die "harus dijalankan sebagai root"
[[ -f $SPOOL   ]] || die "tidak ada berkas kandidat di $SPOOL"
[[ -f $TARGET  ]] || die "$TARGET tidak ditemukan"

# Spool harus milik service account: kalau bukan, ada pihak lain yang menaruhnya.
OWNER=$(stat -c '%U' "$SPOOL")
[[ $OWNER == "$APP_USER" ]] || die "berkas kandidat dimiliki '$OWNER', seharusnya '$APP_USER'"

SIZE=$(stat -c '%s' "$SPOOL")
[[ $SIZE -gt 0 && $SIZE -lt 65536 ]] || die "ukuran berkas kandidat tidak wajar: $SIZE byte"

#--------------------------------------------------------------- validasi ulang
# Hanya tiga bentuk baris yang diterima: kosong, komentar, dan penugasan
# TF_*=nilai. Nilai dibatasi charset konservatif; kutip tunggal/ganda hanya boleh
# sebagai pembungkus. Ini memblokir substitusi perintah ($(...), backtick) yang
# akan tereksekusi bila berkas ini di-`source` oleh skrip shell.
LINE_NO=0
SEEN_KEYS=""
while IFS= read -r line || [[ -n $line ]]; do
  LINE_NO=$((LINE_NO + 1))
  [[ -z ${line//[[:space:]]/} ]] && continue
  [[ ${line#"${line%%[![:space:]]*}"} == \#* ]] && continue

  [[ $line =~ ^[[:space:]]*(TF_[A-Z0-9_]+)=(.*)$ ]] \
    || die "baris $LINE_NO tidak valid (hanya TF_*=nilai yang diterima): ${line:0:60}"

  key=${BASH_REMATCH[1]}
  val=${BASH_REMATCH[2]}

  # Lepas pembungkus kutip bila berpasangan
  if [[ $val == \"*\" && ${#val} -ge 2 ]]; then val=${val:1:${#val}-2}
  elif [[ $val == \'*\' && ${#val} -ge 2 ]]; then val=${val:1:${#val}-2}; fi

  # tr, bukan regex bracket di dalam [[ =~ ]]: penulisan kelas karakter di sana
  # mudah salah (tanda minus membentuk rentang, backslash tidak lepas seperti
  # yang diharapkan) dan pola yang keliru akan menolak semua input — atau lebih
  # buruk, menerima semuanya. Di sini karakter yang DIIZINKAN dihapus; sisa
  # apa pun berarti ada karakter terlarang, termasuk $ ` \ " ' dan kontrol.
  LEFTOVER=$(printf '%s' "$val" | LC_ALL=C tr -d 'A-Za-z0-9 _./:+@,=%|()[]-')
  [[ -z $LEFTOVER ]] \
    || die "baris $LINE_NO ($key) memuat karakter terlarang: $(printf '%s' "$LEFTOVER" | head -c 20)"
  [[ ${#val} -le 512 ]] || die "baris $LINE_NO ($key) terlalu panjang"

  case " $SEEN_KEYS " in *" $key "*) die "kunci ganda: $key" ;; esac
  SEEN_KEYS="$SEEN_KEYS $key"
done < "$SPOOL"

# Kunci yang wajib ada; tanpa ini service akan menolak semua request atau
# membangkitkan kunci sesi acak setiap restart.
for required in TF_INGEST_TOKENS TF_SECRET_KEY TF_ADMIN_PASSWORD TF_DB_PATH; do
  case " $SEEN_KEYS " in
    *" $required "*) : ;;
    *) die "kunci wajib hilang dari berkas kandidat: $required" ;;
  esac
done

#-------------------------------------------------------------------- pasang
install -d -m 750 -o root -g "$APP_USER" "$BACKUP_DIR"
STAMP=$(date +%Y%m%d-%H%M%S)
cp -p "$TARGET" "$BACKUP_DIR/threatfeed.env.$STAMP"
chmod 600 "$BACKUP_DIR/threatfeed.env.$STAMP"

# Salin isi ke berkas sementara di direktori tujuan lalu rename: atomik, dan
# tidak pernah ada momen di mana $TARGET setengah tertulis.
TMP=$(mktemp "${TARGET}.XXXXXX")
cat "$SPOOL" > "$TMP"
# 640, bukan 600: service membaca berkas ini sebagai grup threatfeed.
# Dengan 600 service kehilangan akses baca dan gagal start.
chown root:"$APP_USER" "$TMP"
chmod 640 "$TMP"
sync
mv -f "$TMP" "$TARGET"

rm -f "$SPOOL"

# Simpan 20 backup terakhir
ls -1t "$BACKUP_DIR"/threatfeed.env.* 2>/dev/null | awk 'NR>20' \
  | while read -r old; do rm -f "$old"; done

#------------------------------------------------------------------- restart
# systemd-run, bukan `systemctl restart` langsung: perintah itu akan mematikan
# proses yang sedang menyusun respons HTTP, sehingga dashboard menerima koneksi
# terputus alih-alih konfirmasi. Timer transien 2 detik memberi waktu respons
# terkirim lebih dulu.
if systemd-run --quiet --on-active=3 --unit="threatfeed-restart-$STAMP" \
     /bin/systemctl restart "$UNIT" 2>/dev/null; then
  MSG="applied backup=$STAMP restart=scheduled"
else
  systemctl restart "$UNIT" --no-block 2>/dev/null || systemctl restart "$UNIT" &
  MSG="applied backup=$STAMP restart=immediate"
fi
report ok "$MSG"
printf '%s\n' "$MSG"
