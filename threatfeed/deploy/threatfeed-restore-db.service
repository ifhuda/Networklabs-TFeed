[Unit]
Description=Restore threatfeed database from a staged candidate
Documentation=file:///opt/threatfeed-src/docs/BACKUP-RESTORE.md
# Unit ini menghentikan dan menjalankan kembali threatfeed.service, jadi ia
# tidak boleh dinyatakan bergantung padanya — systemd akan menganggapnya siklik.

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/local/sbin/threatfeed-restore-db
StandardOutput=journal
StandardError=journal
SyslogIdentifier=threatfeed-restore-db
TimeoutStartSec=120
PrivateTmp=true
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictRealtime=true
LockPersonality=true
