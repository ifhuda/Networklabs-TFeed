[Unit]
Description=Watch for a staged threatfeed .env candidate
Documentation=file:///opt/threatfeed-src/docs/SYSTEM-CONFIG.md

[Path]
# Aplikasi menuliskan berkas kandidat, systemd yang menjalankan helper sebagai root.
# Tidak ada sudo, tidak ada setuid, dan unit utama tetap boleh memakai
# NoNewPrivileges=true — flag itu justru memblokir sudo, jadi mekanisme ini
# menghindari konfliknya sepenuhnya alih-alih melemahkan hardening.
PathExists=/var/lib/threatfeed/pending.env
Unit=threatfeed-apply-env.service

[Install]
WantedBy=multi-user.target
