#!/usr/bin/env bash
#===============================================================================
#  threatfeed-restore-db — dijalankan sebagai root oleh systemd
#  (threatfeed-restore-db.path memicunya saat berkas kandidat muncul).
#
#  Menukar berkas database di bawah koneksi SQLite yang sedang hidup akan
#  merusak isinya. Karena itu service dihentikan lebih dulu, berkas ditukar,
#  lalu service dijalankan kembali — dan aplikasi tidak pernah perlu melakukan
#  itu sendiri, sehingga tidak butuh hak istimewa apa pun.
#===============================================================================
set -Eeuo pipefail

DATA_DIR=/var/lib/threatfeed
SPOOL="$DATA_DIR/restore-pending.db"
RESULT="$DATA_DIR/restore-result"
TARGET="$DATA_DIR/threatfeed.db"
APP_USER=threatfeed
UNIT=threatfeed

report() {
  printf '%s|%s|%s\n' "$1" "$(date -Is)" "$2" > "$RESULT" 2>/dev/null || true
  chown "$APP_USER":"$APP_USER" "$RESULT" 2>/dev/null || true
  chmod 644 "$RESULT" 2>/dev/null || true
}
die() {
  printf 'threatfeed-restore-db: %s\n' "$*" >&2
  report error "$*"
  rm -f "$SPOOL"
  # Service selalu dinyalakan lagi: gagal memulihkan tidak boleh berarti feed
  # ikut mati. FortiGate yang berhenti menerima daftar blokir jauh lebih buruk
  # daripada pemulihan yang batal.
  systemctl is-active --quiet "$UNIT" || systemctl start "$UNIT" || true
  exit 1
}

[[ $EUID -eq 0 ]] || die "harus dijalankan sebagai root"
[[ -f $SPOOL ]]   || die "tidak ada kandidat di $SPOOL"

OWNER=$(stat -c '%U' "$SPOOL")
[[ $OWNER == "$APP_USER" ]] || die "kandidat dimiliki '$OWNER', seharusnya '$APP_USER'"

SIZE=$(stat -c '%s' "$SPOOL")
[[ $SIZE -ge 4096 ]] || die "kandidat terlalu kecil ($SIZE byte)"

# Validasi ulang secara independen. Aplikasi sudah memeriksanya, tetapi skrip
# ini berjalan sebagai root dan tidak boleh mempercayai apa pun dari sisi web.
head -c 16 "$SPOOL" | grep -q 'SQLite format 3' || die "bukan berkas database SQLite"
command -v sqlite3 >/dev/null || die "sqlite3 tidak terpasang"
[[ $(sqlite3 "file:$SPOOL?mode=ro" 'PRAGMA quick_check;' 2>/dev/null) == "ok" ]] \
  || die "pemeriksaan integritas gagal"
COUNT=$(sqlite3 "file:$SPOOL?mode=ro" 'SELECT COUNT(*) FROM indicators;' 2>/dev/null) \
  || die "tabel indicators tidak dapat dibaca"
sqlite3 "file:$SPOOL?mode=ro" 'SELECT COUNT(*) FROM audit_log;' >/dev/null 2>&1 \
  || die "tabel audit_log tidak dapat dibaca"

STAMP=$(date +%Y%m%d-%H%M%S)

systemctl stop "$UNIT" || die "gagal menghentikan service"
sleep 1

# Berkas -wal dan -shm milik database lama harus ikut dibuang. Meninggalkannya
# membuat SQLite mencoba memutar ulang jurnal milik database yang berbeda.
if [[ -f $TARGET ]]; then
  mv -f "$TARGET" "$DATA_DIR/threatfeed.db.replaced-$STAMP"
fi
rm -f "$TARGET-wal" "$TARGET-shm"

mv -f "$SPOOL" "$TARGET"
chown "$APP_USER":"$APP_USER" "$TARGET"
chmod 640 "$TARGET"
sync

# Catat pemulihan ke database YANG BARU. Tanpa ini, satu-satunya jejak bahwa
# restore pernah terjadi ikut tertimpa oleh restore itu sendiri — jejak audit
# yang tampak setelahnya adalah milik backup, sehingga peristiwa paling
# berdampak dalam riwayat sistem justru tidak terekam di mana pun.
sqlite3 "$TARGET" <<SQL 2>/dev/null || true
INSERT INTO audit_log (ts, action, actor, client_ip, user_agent,
                       entries_ok, entries_fail, status_code, duration_ms, detail)
VALUES (strftime('%Y-%m-%dT%H:%M:%SZ','now'), 'restore_applied', 'system:helper', '-', '-',
        $COUNT, 0, 200, 0,
        'database dipulihkan; berkas sebelumnya disimpan sebagai threatfeed.db.replaced-$STAMP');
SQL
chown "$APP_USER":"$APP_USER" "$TARGET" "$TARGET-wal" "$TARGET-shm" 2>/dev/null || true

if ! systemctl start "$UNIT"; then
  # Kembalikan database lama bila service menolak start dengan yang baru.
  mv -f "$DATA_DIR/threatfeed.db.replaced-$STAMP" "$TARGET" 2>/dev/null || true
  chown "$APP_USER":"$APP_USER" "$TARGET" 2>/dev/null || true
  systemctl start "$UNIT" || true
  die "service gagal start dengan database baru; database lama dikembalikan"
fi

# Simpan 5 berkas yang tergantikan, sisanya dibuang.
ls -1t "$DATA_DIR"/threatfeed.db.replaced-* 2>/dev/null | awk 'NR>5' \
  | while read -r old; do rm -f "$old"; done

MSG="restored indicators=$COUNT replaced=threatfeed.db.replaced-$STAMP"
report ok "$MSG"
printf '%s\n' "$MSG"
